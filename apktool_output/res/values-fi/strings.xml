    <string name="str_remote_02_info">Yhdistä puhelin ja televisio samaan verkkoon</string>
    <string name="str_remote_03_info">Kun olet asentanut Pango Remote -sovelluksen, yhdistä puhelimesi ja televisiosi samaan verkkoon ja valitse \"Remote\"-toiminto, kun olet yhdistänyt sovelluksen televisioon.</string>
    <string name="str_remote_03_info_kajito">Kun olet asentanut KAJITO-SOVELLUKSEN, yhdistä puhelimesi ja televisiosi samaan verkkoon ja valitse \"Remote\"-toiminto, kun olet yhdistänyt sovelluksen televisioon</string>
