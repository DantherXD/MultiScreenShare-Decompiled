    <string name="str_screen_cast_02_info_kajito">TV:si tukee suoraa WiFi-yhteyttä, joten sinun ei tarvitse olla yhteydessä samaan wifi-verkkoon suoratoistaaksesi näyttöäsi KAJITO-SOVELLUKSESTA</string>
    <string name="str_screen_cast_03">Tapa 2 (Pangon kaukosäätimen kautta)</string>
