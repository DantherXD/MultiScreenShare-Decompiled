    <string name="stepone">Pārliecinieties, vai tālrunis un televizors ir savienoti ar vienu un to pašu LAN.</string>
    <string name="str_cast_iphone_01_info">Izmantojiet iPhone iebūvēto ekrāna apraides funkciju, lai apraidītu ekrānu</string>
    <string name="str_cast_iphone_02_info">Pievienojiet tālruni un televizoru vienam tīklam</string>
    <string name="str_cast_iphone_03_info">Pievienojiet tālruni un televizoru vienam tīklam, velciet uz leju pa ekrānu, lai atrastu ikonu \"Ekrāna spoguļošana\", izvēlieties televizora savienojumu, lai apraidītu ekrānu.</string>
    <string name="str_file_share_01_info">Ir trīs veidi, kā kopīgot attēlus, videoklipus un mūziku no tālruņa, lai atskaņotu to televizorā</string>
    <string name="str_file_share_02">Kopīgot Android ierīcēm (izmantojot Pango Remote)</string>
    <string name="str_file_share_02_info">Pēc lietotnes Pango Remote instalēšanas pievienojiet tālruni un televizoru vienam tīklam un pēc savienojuma izveides ar televizoru lietotnē atlasiet funkciju \"File share\".</string>
    <string name="str_file_share_02_info_kajito">Pēc lietotnes KAJITO APP instalēšanas pievienojiet tālruni un televizoru vienam tīklam un pēc savienojuma izveides ar televizoru lietotnē atlasiet funkciju \"Failu kopīgošana\".</string>
    <string name="str_file_share_02_kajito">Kopīgot Android ierīcēm (izmantojot KAJITO APP)</string>
    <string name="str_file_share_03">Kopīgot operētājsistēmai iOS (izmantojot AirPlay)</string>
    <string name="str_file_share_03_info">Pievienojiet tālruni un televizoru vienam tīklam, kopīgojiet failus no tālruņa ar televizoru, izmantojot funkciju \"AirPlay\".</string>
    <string name="str_file_share_04">Kopīgot operētājsistēmām Android un iOS (izmantojot mūzikas/video lietojumprogrammu)</string>
    <string name="str_file_share_04_info">Pievienojiet tālruni un televizoru vienam tīklam, pašreizējā mūzikas un video atskaņošanas logā atrodiet ikonu \"Cast\", lai palaistu ekrāna projekciju.</string>
    <string name="str_remote_01_info">"Instalējiet lietotni \"Pango Remote\", lai vadītu televizoru no tālruņa.
Piezīme. Tikai Android lietotājiem, izņemot iOS. iOS lietotāji, lūdzu, izmantojiet tālvadības pults funkciju lietotnē Google Home."</string>
    <string name="str_remote_01_info_kajito">"Instalējiet lietotni \"KAJITO\", lai vadītu televizoru no tālruņa.
Piezīme. Tikai Android lietotājiem, izņemot iOS. iOS lietotāji, lūdzu, izmantojiet tālvadības pults funkciju lietotnē Google Home."</string>
    <string name="str_remote_02_info">Pievienojiet tālruni un televizoru vienam tīklam</string>
    <string name="str_remote_03_info">Pēc lietotnes Pango Remote instalēšanas pievienojiet tālruni un televizoru vienam tīklam un pēc savienojuma izveides ar televizoru lietotnē atlasiet funkciju \"Remote\".</string>
    <string name="str_remote_03_info_kajito">Pēc lietotnes KAJITO APP instalēšanas pievienojiet tālruni un televizoru vienam tīklam un pēc savienojuma izveides ar televizoru lietotnē atlasiet funkciju \"Remote\"</string>
    <string name="str_screen_cast_01">"Instalējiet lietotni 'Pango Remote', lai ekrāna apraidi televizorā"</string>
    <string name="str_screen_cast_01_kajito">"Instalējiet lietotni 'KAJITO', lai ekrāna apraidi televizorā"</string>
    <string name="str_screen_cast_02">1.metode (Wi-Fi tiešais)</string>
    <string name="str_screen_cast_02_info">Jūsu televizors atbalsta tiešo WiFi, tāpēc, lai apraidītu ekrānu lietotnē Pango Remote, jums nav jābūt savienotam ar to pašu Wi-Fi.</string>
    <string name="str_screen_cast_02_info_kajito">Jūsu televizors atbalsta tiešo Wi-Fi, tāpēc jums nav jābūt savienotam ar to pašu Wi-Fi, lai apraidītu ekrānu lietotnē KAJITO APP</string>
    <string name="str_screen_cast_03">2.metode (izmantojot Pango Remote)</string>
    <string name="str_screen_cast_03_info">Pēc lietotnes Pango Remote instalēšanas pievienojiet tālruni un televizoru vienam tīklam un pēc savienojuma izveides ar televizoru lietotnē atlasiet funkciju \"Screen Cast\".</string>
    <string name="str_screen_cast_03_info_kajito">Pēc lietotnes KAJITO APP instalēšanas pievienojiet tālruni un televizoru vienam tīklam un pēc savienojuma izveides ar televizoru lietotnē atlasiet funkciju \"Screen Cast\".</string>
    <string name="str_screen_cast_03_kajito">2. metode (izmantojot KAJITO APP)</string>
    <string name="str_screen_cast_miracast_info">Atveriet iestatījumus, atlasiet apraidi, izvēlieties pievienot televizoru, lai apraidītu ekrānu</string>
