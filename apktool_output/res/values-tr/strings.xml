    <string name="str_cast_iphone_01_info">"Ekranı yayınlamak için iPhone'un yerleşik ekran yayınlama işlevini kullanın"</string>
    <string name="str_cast_iphone_02_info">"Telefonunuzu ve TV'nizi aynı ağa bağlayın"</string>
    <string name="str_cast_iphone_03_info">"Telefonunuzu ve TV'nizi aynı ağa bağlayın, \"Ekran Yansıtma\" simgesini bulmak için ekranı aşağı kaydırın, ekranı yayınlamak için TV'nizi bağlamayı seçin"</string>
    <string name="str_file_share_01_info">"Telefonunuzdaki resimleri, videoları ve müziği TV'nizde oynatmak üzere paylaşmanın üç yolu vardır"</string>
    <string name="str_file_share_02">Android için paylaş (Pango Remote ile)</string>
    <string name="str_file_share_02_info">"Pango Remote uygulamasını yükledikten sonra telefonunuzu ve TV'nizi aynı ağa bağlayın ve uygulamada TV'ye bağlandıktan sonra Dosya paylaşımı fonksiyonunu seçin."</string>
    <string name="str_file_share_02_info_kajito">"KAJITO UYGULAMASINI yükledikten sonra telefonunuzu ve televizyonunuzu aynı ağa bağlayın, ve uygulamada TV'ye bağlandıktan sonra \"Dosya paylaşımı\" işlevini seçin"</string>
    <string name="str_file_share_02_kajito">Android için paylaş (KAJITO UYGULAMASI Üzerinden)</string>
    <string name="str_file_share_03">iOS için Paylaş (AirPlay Aracılığıyla)</string>
    <string name="str_file_share_03_info">"Telefonunuzu ve TV'nizi aynı ağa bağlayın, \"AirPlay\" işlevi aracılığıyla telefonunuzdaki dosyaları TV'nizle paylaşın"</string>
    <string name="str_file_share_04">Android ve iOS için Paylaş (Müzik/Video uygulamasıyla)</string>
    <string name="str_file_share_04_info">"Telefonunuzu ve TV'nizi aynı ağa bağlayın, bir ekran projeksiyonu başlatmak için mevcut müzik ve video oynatma penceresinde\"Yayınla\" simgesini bulun"</string>
    <string name="str_remote_01_info">"TV'nizi telefonunuzdan kontrol etmek için \"Pango Remote\" uygulamasını yükleyin.
Not: Yalnızca Android kullanıcıları içindir, iOS hariç. iOS kullanıcıları lütfen Google Home uygulamasındaki uzaktan kumanda işlevini kullanın."</string>
    <string name="str_remote_01_info_kajito">"Telefonunuzdan TV'nizi kontrol etmek için \"KAJITO\" uygulamasını yükleyin.
Not: Yalnızca Android kullanıcıları için, iOS hariç. iOS kullanıcıları, lütfen Google Home uygulamasındaki uzaktan kumanda işlevini kullanın."</string>
    <string name="str_remote_02_info">"Telefonunuzu ve TV'nizi aynı ağa bağlayın"</string>
    <string name="str_remote_03_info">"Pango Remote uygulamasını yükledikten sonra telefonunuzu ve TV'nizi aynı ağa bağlayın ve uygulamada TV'ye bağlandıktan sonra \"Uzak\" fonksiyonunu seçin"</string>
    <string name="str_remote_03_info_kajito">"KAJITO APP'yi yükledikten sonra telefonunuzu ve televizyonunuzu aynı ağa bağlayın ve uygulamada televizyona bağlandıktan sonra \"Uzaktan\" işlevini seçin"</string>
    <string name="str_screen_cast_01">"TV'nize ekran yayını yapmak için 'Pango Remote' uygulamasını yükleyin"</string>
    <string name="str_screen_cast_01_kajito">"TV'nize ekran yayını yapmak için 'KAJITO' uygulamasını yükleyin"</string>
    <string name="str_screen_cast_02">Yöntem 1 (WiFi doğrudan)</string>
    <string name="str_screen_cast_02_info">"TV'niz WiFi doğrudan'i desteklediğinden ekranınızı Pango Remote uygulamasında yayınlamak için aynı kablosuz ağa bağlı olmanıza gerek yoktur"</string>
    <string name="str_screen_cast_02_info_kajito">"TV'niz WiFi direct'i desteklediğinden, KAJITO UYGULAMASINDA ekranınızı yayınlamak için aynı WiFi'ye bağlı olmanız gerekmez"</string>
    <string name="str_screen_cast_03">Yöntem 2 (Pango Remote aracılığıyla)</string>
    <string name="str_screen_cast_03_info">"Pango Remote uygulamasını yükledikten sonra telefonunuzu ve TV'nizi aynı ağa bağlayın ve uygulamada TV'ye bağlandıktan sonra \"Ekran Yayını\" fonksiyonunu seçin"</string>
    <string name="str_screen_cast_03_info_kajito">KAJITO UYGULAMASINI yükledikten sonra telefonunuzu ve televizyonunuzu aynı ağa bağlayın ve uygulamada televizyona bağlandıktan sonra \"Ekran Yayını\" işlevini seçin</string>
    <string name="str_screen_cast_03_kajito">Yöntem 2 (KAJITO UYGULAMASI Üzerinden)</string>
    <string name="str_screen_cast_miracast_info">"Ayarlara girin, yayınla'yı seçin, ekranı yayınlamak için televizyonunuzu bağlamayı seçin"</string>
