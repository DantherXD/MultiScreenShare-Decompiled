    <string name="stepone">დარწმუნდით, რომ თქვენი ტელეფონი და ტელევიზორი დაკავშირებულია იმავე LAN-თან.</string>
    <string name="str_cast_iphone_01_info">გამოიყენეთ iPhone-ის ჩაშენებული ეკრანის გადაცემის ფუნქცია ეკრანის გადასაცემად</string>
    <string name="str_cast_iphone_02_info">შეაერთეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში</string>
    <string name="str_cast_iphone_03_info">შეაერთეთ თქვენი ტელეფონი და ტელევიზორი ერთსა და იმავე ქსელში, გადაიტანეთ ეკრანი ქვემოთ, რათა იპოვოთ \"Screen Mirroring\" ხატულა, აირჩიეთ ტელევიზორის დაკავშირება ეკრანის გადასაცემად</string>
    <string name="str_file_share_01_info">არსებობს სამი გზა, რომლითაც შეგიძლიათ გააზიაროთ სურათები, ვიდეო და მუსიკა თქვენი ტელეფონიდან ტელევიზორში დასაკრავად</string>
    <string name="str_file_share_02">გაზიარება ანდროიდისთვის (პანგოს დისტანციური მართვის საშუალებით)</string>
    <string name="str_file_share_02_info">Pango Remote აპლიკაციის ინსტალაციის შემდეგ, დაუკავშირეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში და აირჩიეთ \"File share\" ფუნქცია აპში ტელევიზორთან დაკავშირების შემდეგ.</string>
    <string name="str_file_share_02_info_kajito">KAJITO აპის ინსტალაციის შემდეგ დაუკავშირეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში და აირჩიეთ \"ფაილის გაზიარება\" ფუნქცია ტელევიზორთან დაკავშირების შემდეგ აპში</string>
    <string name="str_file_share_02_kajito">გაზიარება Android-ისთვის (KAJITO APP-ის მეშვეობით)</string>
    <string name="str_file_share_03">გაზიარება iOS-ისთვის (AirPlay-ის საშუალებით)</string>
    <string name="str_file_share_03_info">შეაერთეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში, გააზიარეთ ფაილები თქვენი ტელეფონიდან თქვენს ტელევიზორში \"AirPlay\" ფუნქციის მეშვეობით</string>
    <string name="str_file_share_04">გაზიარება Android-ისთვის და iOS-ისთვის (მუსიკის/ვიდეო აპლიკაციის საშუალებით)</string>
    <string name="str_file_share_04_info">შეაერთეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში, იპოვეთ \"Cast\" ხატულა მუსიკისა და ვიდეოს დაკვრის მიმდინარე ფანჯარაში ეკრანის პროექციის გასაშვებად</string>
    <string name="str_remote_01_info">"დააინსტალირეთ \"Pango Remote\" აპი, რათა მართოთ თქვენი ტელევიზორი თქვენი ტელეფონიდან.
შენიშვნა: მხოლოდ Android-ის მომხმარებლებისთვის, iOS-ის გამოკლებით. iOS-ის მომხმარებლებმა, გთხოვთ, გამოიყენოთ დისტანციური მართვის ფუნქცია Google Home აპში."</string>
    <string name="str_remote_01_info_kajito">"დააინსტალირეთ \"KAJITO\" აპი, რათა მართოთ თქვენი ტელევიზორი თქვენი ტელეფონიდან.
შენიშვნა: მხოლოდ Android-ის მომხმარებლებისთვის, iOS-ის გამოკლებით. iOS-ის მომხმარებლებმა, გთხოვთ, გამოიყენოთ დისტანციური მართვის ფუნქცია Google Home აპში."</string>
    <string name="str_remote_02_info">შეაერთეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში</string>
    <string name="str_remote_03_info">Pango Remote აპლიკაციის ინსტალაციის შემდეგ, დაუკავშირეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში და აირჩიეთ \"დისტანციური\" ფუნქცია აპში ტელევიზორთან დაკავშირების შემდეგ.</string>
    <string name="str_remote_03_info_kajito">KAJITO აპის ინსტალაციის შემდეგ დაუკავშირეთ თქვენი ტელეფონი და ტელევიზორი იმავე ქსელში და აირჩიეთ \"დისტანციური\" ფუნქცია ტელევიზორთან დაკავშირების შემდეგ აპში</string>
    <string name="str_screen_cast_01">"დააინსტალირეთ 'Pango Remote' აპი თქვენს ტელევიზორზე ეკრანის გადასაცემად"</string>
    <string name="str_screen_cast_01_kajito">"დააინსტალირეთ 'KAJITO' აპი თქვენს ტელევიზორზე გადასაცემად ეკრანზე"</string>
