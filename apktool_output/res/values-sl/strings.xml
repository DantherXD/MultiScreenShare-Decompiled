    <string name="str_cast_iphone_02_info">Povežite telefon in TV z istim omrežjem</string>
    <string name="str_cast_iphone_03_info">"Povežite telefon in TV z istim omrežjem, povlecite po zaslonu navzdol, da poiščete ikono  Screen Mirroring\", izberite povezavo s televizorjem za predvajanje zaslona"</string>
    <string name="str_file_share_01_info">Slike, videoposnetke in glasbo iz telefona lahko delite na tri načine za predvajanje na televizorju</string>
    <string name="str_file_share_02">Delite za android (prek Pango Remote)</string>
    <string name="str_file_share_02_info">Po namestitvi aplikacije Pango Remote povežite telefon in TV z istim omrežjem in po povezavi s TV v aplikaciji izberite funkcijo \"Deljenje datotek\".</string>
    <string name="str_file_share_02_info_kajito">Po namestitvi APLIKACIJE KAJITO povežite telefon in TV z istim omrežjem in po povezavi s TV v aplikaciji izberite funkcijo \"Deljenje datotek\"</string>
    <string name="str_file_share_02_kajito">Skupna raba za android (prek APLIKACIJE KAJITO)</string>
    <string name="str_file_share_03">Skupna raba za iOS (prek AirPlay)</string>
    <string name="str_file_share_03_info">Povežite telefon in televizor v isto omrežje, delite datoteke iz telefona s televizorjem prek funkcije \"AirPlay\"</string>
    <string name="str_file_share_04">Skupna raba za Android in iOS (prek aplikacije Glasba/Video)</string>
    <string name="str_file_share_04_info">Povežite telefon in TV z istim omrežjem, poiščite ikono \"Cast\" v trenutnem oknu za predvajanje glasbe in videa, da zaženete projekcijo zaslona</string>
    <string name="str_remote_01_info">"Namestite aplikacijo \"Pango Remote\" za nadzor televizorja iz telefona.
Opomba: Samo za uporabnike Androida, razen za iOS. Uporabniki iOS-a, prosimo, uporabite funkcijo daljinskega upravljanja v aplikaciji Google Home."</string>
    <string name="str_remote_01_info_kajito">"Namestite aplikacijo \"KAJITO\" za nadzor televizorja iz telefona.
Opomba: Samo za uporabnike Androida, razen za iOS. Uporabniki sistema iOS, prosimo, uporabite funkcijo daljinskega upravljanja v aplikaciji Google Home."</string>
    <string name="str_remote_02_info">Povežite telefon in TV z istim omrežjem</string>
    <string name="str_remote_03_info">Po namestitvi aplikacije Pango Remote povežite telefon in TV z istim omrežjem in po povezavi s TV v aplikaciji izberite funkcijo \"Oddaljeno\".</string>
    <string name="str_remote_03_info_kajito">Po namestitvi APLIKACIJE KAJITO povežite telefon in TV z istim omrežjem in po povezavi s TV v aplikaciji izberite funkcijo \"Oddaljeno\"</string>
    <string name="str_screen_cast_01">"Namestite aplikacijo 'Pango Remote' za predvajanje zaslona na televizorju"</string>
    <string name="str_screen_cast_01_kajito">"Namestite aplikacijo 'KAJITO' za predvajanje zaslona na televizorju"</string>
    <string name="str_screen_cast_02">1. način (neposredno WiFi)</string>
    <string name="str_screen_cast_02_info">Vaš televizor podpira neposredno WiFi, zato vam ni treba biti povezan z istim Wi-Fi, da predvajate svoj zaslon v aplikaciji Pango Remote</string>
    <string name="str_screen_cast_02_info_kajito">Vaš TV podpira WiFi Direct, zato vam za predvajanje zaslona v APLIKACIJI KAJITO ni treba biti povezan z istim omrežjem Wi-Fi</string>
    <string name="str_screen_cast_03">2. način (prek Pango Remote)</string>
    <string name="str_screen_cast_03_info">Po namestitvi aplikacije Pango Remote povežite telefon in TV z istim omrežjem in po povezavi s TV v aplikaciji izberite funkcijo \"Screen Cast\".</string>
    <string name="str_screen_cast_03_info_kajito">Po namestitvi APLIKACIJE KAJITO povežite telefon in TV z istim omrežjem in po povezavi s TV v aplikaciji izberite funkcijo \"Screen Cast\"</string>
    <string name="str_screen_cast_03_kajito">2. način (prek APLIKACIJE KAJITO)</string>
    <string name="str_screen_cast_miracast_info">Vstopite v nastavitve，izberite predvajanje，izberite povezavo televizorja za predvajanje zaslona</string>
