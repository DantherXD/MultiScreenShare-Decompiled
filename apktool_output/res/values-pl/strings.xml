    <string name="stepone">Upewnij się, że telefon i telewizor są podłączone do tej samej sieci LAN.</string>
    <string name="str_cast_iphone_01_info">"Użyj wbudowanej funkcji przesyłania ekranu iPhone'a, aby przesłać ekran"</string>
    <string name="str_cast_iphone_02_info">Podłącz telefon i telewizor do tej samej sieci</string>
    <string name="str_cast_iphone_03_info">Podłącz telefon i telewizor do tej samej sieci, przesuń ekran w dół, aby znaleźć ikonę „Screen Mirroring”, wybierz podłączenie telewizora w celu przesłania ekranu</string>
    <string name="str_file_share_01_info">Istnieją trzy sposoby udostępniania zdjęć, filmów i muzyki z telefonu w celu odtwarzania ich na telewizorze</string>
    <string name="str_file_share_02">Udostępnij dla Androida (za pomocą pilota Pango)</string>
    <string name="str_file_share_02_info">Po zainstalowaniu aplikacji Pango Remote podłącz telefon i telewizor do tej samej sieci, a po podłączeniu do telewizora w aplikacji wybierz funkcję „Udostępnij plik”.</string>
    <string name="str_file_share_02_info_kajito">Po zainstalowaniu aplikacji KAJITO podłącz telefon i telewizor do tej samej sieci i wybierz funkcję „Udostępnianie plików” po połączeniu się z telewizorem w aplikacji</string>
    <string name="str_file_share_02_kajito">Udostępnianie dla systemu Android (za pośrednictwem aplikacji KAJITO)</string>
    <string name="str_file_share_03">Udostępnij na iOS (przez AirPlay)</string>
    <string name="str_file_share_03_info">Podłącz telefon i telewizor do tej samej sieci, udostępniaj pliki z telefonu na telewizorze za pomocą funkcji „AirPlay”.</string>
    <string name="str_file_share_04">Udostępnij na Androida i iOS (za pośrednictwem aplikacji Muzyka/Wideo)</string>
    <string name="str_file_share_04_info">Podłącz telefon i telewizor do tej samej sieci, znajdź ikonę „Przesyłaj” w bieżącym oknie odtwarzania muzyki i wideo, aby uruchomić projekcję ekranu</string>
    <string name="str_remote_01_info">"Zainstaluj aplikację „Pango Remote”, aby sterować telewizorem za pomocą telefonu.
Uwaga: Tylko dla użytkowników Androida, z wyłączeniem iOS. Użytkownicy iOS powinni używać funkcji pilota w aplikacji Google Home."</string>
    <string name="str_remote_01_info_kajito">"Zainstaluj aplikację „KAJITO”, aby sterować telewizorem za pomocą telefonu.
Uwaga: Tylko dla użytkowników Androida, z wyłączeniem iOS. Użytkownicy systemu iOS powinni skorzystać z funkcji zdalnego sterowania w aplikacji Google Home."</string>
    <string name="str_remote_02_info">Podłącz telefon i telewizor do tej samej sieci</string>
    <string name="str_remote_03_info">Po zainstalowaniu aplikacji Pango Remote podłącz telefon i telewizor do tej samej sieci, a po podłączeniu do telewizora w aplikacji wybierz funkcję „Remote”.</string>
    <string name="str_remote_03_info_kajito">Po zainstalowaniu aplikacji KAJITO podłącz telefon i telewizor do tej samej sieci i wybierz funkcję „Pilot” po połączeniu z telewizorem w aplikacji</string>
    <string name="str_screen_cast_01">"Zainstaluj aplikację 'Pango Remote', aby przesyłać ekran na telewizor"</string>
    <string name="str_screen_cast_01_kajito">"Zainstaluj aplikację 'KAJITO', aby przesyłać ekran do telewizora"</string>
    <string name="str_screen_cast_02">Metoda 1 (bezpośrednio Wi-Fi)</string>
    <string name="str_screen_cast_02_info">Twój telewizor obsługuje bezpośrednie Wi-Fi, więc nie musisz być podłączony do tej samej sieci Wi-Fi, aby przesyłać ekran w aplikacji Pango Remote</string>
    <string name="str_screen_cast_02_info_kajito">Twój telewizor obsługuje funkcję WiFi Direct, więc nie musisz być podłączony do tej samej sieci Wi-Fi, aby przesyłać ekran w aplikacji KAJITO</string>
    <string name="str_screen_cast_03">Metoda 2 (za pomocą pilota Pango)</string>
    <string name="str_screen_cast_03_info">Po zainstalowaniu aplikacji Pango Remote podłącz telefon i telewizor do tej samej sieci, a po podłączeniu do telewizora w aplikacji wybierz funkcję „Screen Cast”.</string>
    <string name="str_screen_cast_03_info_kajito">Po zainstalowaniu aplikacji KAJITO podłącz telefon i telewizor do tej samej sieci i wybierz funkcję „Screen Cast” po połączeniu z telewizorem w aplikacji</string>
    <string name="str_screen_cast_03_kajito">Metoda 2 (za pośrednictwem aplikacji KAJITO)</string>
    <string name="str_screen_cast_miracast_info">Wejdź w Ustawienia, wybierz Przesyłaj, wybierz podłączenie telewizora, aby przesłać ekran</string>
