    <string name="str_cast_iphone_01_info">השתמש בפונקציית יציאת המסך המובנית באייפון כדי להטיל את המסך</string>
    <string name="str_cast_iphone_02_info">חבר את הטלפון והטלוויזיה שלך לאותה רשת</string>
    <string name="str_cast_iphone_03_info">חבר את הטלפון והטלוויזיה שלך לאותה רשת, החלק את המסך כלפי מטה כדי למצוא את הסמל\"שיקוף מסך\", בחר לחבר את הטלוויזיה כדי להעביר את המסך</string>
    <string name="str_file_share_01_info">ישנן שלוש דרכים שבהן תוכל לשתף תמונות, סרטונים ומוסיקה מהטלפון שלך כדי לנגן בטלוויזיה שלך</string>
    <string name="str_file_share_02">שתף עבור אנדרואיד (באמצעות שלט Pango)</string>
    <string name="str_file_share_02_info">לאחר התקנת אפליקציית Pango Remote, חבר את הטלפון והטלוויזיה לאותה רשת, ובחר בפונקציית \"שיתוף קבצים\" לאחר החיבור לטלוויזיה באפליקציה</string>
    <string name="str_file_share_02_info_kajito">לאחר התקנת אפליקציית KAJITO, חבר את הטלפון והטלוויזיה שלך לאותה רשת, ובחר בפונקציה \"שיתוף קבצים\" לאחר התחברות לטלוויזיה באפליקציה</string>
    <string name="str_file_share_02_kajito">שיתוף עבור אנדרואיד (דרך האפליקציה KAJITO)</string>
    <string name="str_file_share_03">שתף עבור iOS (באמצעות AirPlay)</string>
    <string name="str_file_share_03_info">חבר את הטלפון והטלוויזיה שלך לאותה רשת, שתף קבצים מהטלפון שלך לטלוויזיה שלך באמצעות הפונקציה \"AirPlay\".</string>
    <string name="str_file_share_04">שתף עבור אנדרואיד ו-iOS (באמצעות אפליקציית מוזיקה/וידאו)</string>
    <string name="str_file_share_04_info">חבר את הטלפון והטלוויזיה שלך לאותה רשת, מצא את סמל\"Cast\" בחלון השמעת מוזיקה ווידאו הנוכחי כדי להפעיל הקרנת מסך</string>
    <string name="str_remote_01_info">"התקן את אפליקציית \"Pango Remote\" כדי לשלוט בטלוויזיה מהטלפון.
הערה: למשתמשי אנדרואיד בלבד, למעט iOS. משתמשי iOS, אנא השתמשו בפונקציית השלט הרחוק באפליקציית Google Home."</string>
    <string name="str_remote_01_info_kajito">"התקן את אפליקציית \"KAJITO\" כדי לשלוט בטלוויזיה מהטלפון שלך.
הערה: למשתמשי אנדרואיד בלבד, לא כולל iOS. משתמשי iOS, אנא השתמשו בפונקציית השלט הרחוק באפליקציית Google Home."</string>
    <string name="str_remote_02_info">חבר את הטלפון והטלוויזיה שלך לאותה רשת</string>
    <string name="str_remote_03_info">לאחר התקנת אפליקציית Pango Remote, חבר את הטלפון והטלוויזיה לאותה רשת, ובחר בפונקציית \"מרוחק\" לאחר חיבור לטלוויזיה באפליקציה</string>
    <string name="str_remote_03_info_kajito">לאחר התקנת אפליקציית KAJITO, חבר את הטלפון והטלוויזיה שלך לאותה רשת ובחר את הפונקציה \"מרוחק\" לאחר חיבור לטלוויזיה באפליקציה</string>
    <string name="str_screen_cast_01">"התקן את אפליקציית 'Pango Remote' כדי להעביר מסך לטלוויזיה שלך"</string>
    <string name="str_screen_cast_01_kajito">"התקן את האפליקציה 'KAJITO' כדי להעביר מסך לטלוויזיה שלך"</string>
    <string name="str_screen_cast_02">שיטה 1 (וויי - פיי ישיר)</string>
    <string name="str_screen_cast_02_info">הטלוויזיה שלך תומכת ב-רשת אלחוטית ישירה, כך שאתה לא צריך להיות מחובר לאותו וויי - פיי כדי להקרין את המסך שלך באפליקציית Pango Remote</string>
    <string name="str_screen_cast_02_info_kajito">הטלוויזיה שלך תומכת ב-WiFi ישיר, כך שאינך צריך להיות מחובר לאותו wifi כדי להעביר את המסך שלך באפליקציית KAJITO</string>
    <string name="str_screen_cast_03">שיטה 2 (דרך שלט Pango)</string>
    <string name="str_screen_cast_03_info">לאחר התקנת אפליקציית Pango Remote, חבר את הטלפון והטלוויזיה לאותה רשת, ובחר בפונקציית \"העברה מסך\" לאחר חיבור לטלוויזיה באפליקציה</string>
    <string name="str_screen_cast_03_info_kajito">לאחר התקנת אפליקציית KAJITO, חבר את הטלפון והטלוויזיה שלך לאותה רשת ובחר בפונקציית \"העברה מסך\" לאחר התחברות לטלוויזיה באפליקציה</string>
    <string name="str_screen_cast_03_kajito">שיטה 2 (באמצעות KAJITO APP)</string>
    <string name="str_screen_cast_miracast_info">היכנסו להגדרות, בחרו בהעברה, בחרו לחבר את הטלוויזיה כדי להעביר את המסך</string>
