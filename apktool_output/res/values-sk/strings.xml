    <string name="str_cast_iphone_02_info">Pripojte telefón a televízor k rovnakej sieti</string>
    <string name="str_cast_iphone_03_info">"Pripojte telefón a televízor k rovnakej sieti, posuňte obrazovku nadol a nájdite ikonu  Zrkadlenie obrazovky\", vyberte pripojenie televízora, aby ste preniesli obrazovku"</string>
    <string name="str_file_share_01_info">Existujú tri spôsoby, ako môžete zdieľať obrázky, videá a hudbu z telefónu a prehrávať ich na televízore</string>
    <string name="str_file_share_02">Zdieľať pre Android (cez Pango Remote)</string>
    <string name="str_file_share_02_info">Po nainštalovaní aplikácie Pango Remote pripojte telefón a televízor k rovnakej sieti a po pripojení k televízoru v aplikácii vyberte funkciu \"Zdieľanie súborov\".</string>
    <string name="str_file_share_02_info_kajito">Po nainštalovaní aplikácie KAJITO APP pripojte telefón a televízor k rovnakej sieti a po pripojení k televízoru v aplikácii vyberte funkciu \"Zdieľanie súborov\"</string>
    <string name="str_file_share_02_kajito">Zdieľať pre Android (cez APP KAJITO)</string>
    <string name="str_file_share_03">Zdieľať pre iOS (cez AirPlay)</string>
    <string name="str_file_share_03_info">Pripojte telefón a televízor k rovnakej sieti, zdieľajte súbory z telefónu do televízora pomocou funkcie \"AirPlay\"</string>
    <string name="str_file_share_04">Zdieľať pre Android a iOS (prostredníctvom aplikácie Hudba/Video)</string>
    <string name="str_file_share_04_info">Pripojte svoj telefón a televízor k rovnakej sieti, nájdite ikonu \"Prenášať\" v aktuálnom okne prehrávania hudby a videa a spustite projekciu obrazovky</string>
    <string name="str_remote_01_info">"Nainštalujte si aplikáciu \"Pango Remote\" na ovládanie televízora z telefónu.
Poznámka: Len pre používateľov systému Android, s výnimkou systému iOS. Používatelia systému iOS, použite funkciu diaľkového ovládania v aplikácii Google Home."</string>
    <string name="str_remote_01_info_kajito">"Nainštalujte si aplikáciu \"KAJITO\" na ovládanie televízora z telefónu.
Poznámka: Len pre používateľov systému Android, okrem systému iOS. Používatelia systému iOS, použite funkciu diaľkového ovládania v aplikácii Google Home."</string>
    <string name="str_remote_02_info">Pripojte telefón a televízor k rovnakej sieti</string>
    <string name="str_remote_03_info">Po nainštalovaní aplikácie Pango Remote pripojte telefón a televízor k rovnakej sieti a po pripojení k televízoru v aplikácii vyberte funkciu \"Diaľkové ovládanie\".</string>
    <string name="str_remote_03_info_kajito">Po nainštalovaní aplikácie KAJITO APP pripojte telefón a televízor k rovnakej sieti a po pripojení k televízoru v aplikácii vyberte funkciu \"Vzdialené\"</string>
    <string name="str_screen_cast_01">"Nainštalujte si aplikáciu 'Pango Remote', aby ste mohli prenášať obrazovku do svojho televízora"</string>
    <string name="str_screen_cast_01_kajito">"Nainštalujte si aplikáciu 'KAJITO' na prehratie obrazovky do televízora"</string>
    <string name="str_screen_cast_02">Metóda 1 (priame WiFi)</string>
    <string name="str_screen_cast_02_info">Váš televízor podporuje funkciu WiFi priame, takže na prenesenie obrazovky do aplikácie Pango Remote nemusíte byť pripojený k rovnakej sieti Wi-Fi</string>
    <string name="str_screen_cast_02_info_kajito">Váš televízor podporuje priame pripojenie Wi-Fi, takže na prenesenie obrazovky do APLIKÁCIE KAJITO nemusíte byť pripojený k rovnakej sieti Wi-Fi</string>
    <string name="str_screen_cast_03">Metóda 2 (cez Pango Remote)</string>
    <string name="str_screen_cast_03_info">Po nainštalovaní aplikácie Pango Remote pripojte telefón a televízor k rovnakej sieti a po pripojení k televízoru v aplikácii vyberte funkciu \"Screen Cast\"</string>
    <string name="str_screen_cast_03_info_kajito">Po nainštalovaní aplikácie KAJITO APP pripojte telefón a televízor k rovnakej sieti a po pripojení k televízoru v aplikácii vyberte funkciu \"Screen Cast\"</string>
